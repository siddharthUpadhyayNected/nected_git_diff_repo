      "snippet": {
 "value": "const data = {{.Zepto_Coupon_Condition_Check.output}};\r\nconst coupons = [];\r\n\r\ndata.forEach(group => {\r\n  if (Array.isArray(group.output)) {\r\n    group.output.forEach(coupon => {\r\n      coupons.push(coupon);\r\n    });\r\n  }\r\n});\r\n\r\nconst uniqueCoupons = [];\r\nconst duplicateCodes = {};\r\n\r\ncoupons.forEach(coupon => {\r\n  if (!duplicateCodes[coupon.coupon]) {\r\n    duplicateCodes[coupon.coupon] = true;\r\n    uniqueCoupons.push(coupon);\r\n  }\r\n});\r\n\r\ncoupons; ",
