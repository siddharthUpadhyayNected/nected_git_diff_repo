      "snippet": {
 "value": "//We are making a cart variable that contains the cart list data provided as an input to the trigger. We are putting it in the curly braces because this is the dynamic json data we are expecting from the user end that will be recieved by the trigger from the user end.\r\n\r\nlet cart = {{.Trigger.cart.cart_list}};\r\n\r\n//Calculating the total_sum using the SUMLIST present in the nected formulas\r\nlet cartTotal = SUM_LIST(list=cart, 'totalPrice');\r\n\r\n//intializing the result array and hard coding the first two values and presenting the total cart value as the third value.\r\n\r\nlet result = [\r\n  {\r\n    type: \"overall\",\r\n    name: \"Payment Gateway\",\r\n    value: cartTotal\r\n  },\r\n];\r\nresult;",
