      "snippet": {
 "value": "function buildGmailPayload() {\n  // ====== EDIT THESE ======\n  var senderName     = \"Siddharth Upadhyay\";\n  var senderEmail    = \"siddharth@nected.ai\";\n  var recipientEmail = \"{{.Trigger.to_email}}\";\n  var recipientName  = \"{{.Trigger.to_name}}\";\n  var productName    = \"{{.Trigger.product_name}}\";\n  var orderId        = \"{{.Trigger.order_id}}\";\n  var orderTotal     = \"{{.Trigger.order_total}}\";\n  // ========================\n\n  var subject = \"Your order #\" + orderId + \" is confirmed\";\n\n  var htmlBody = ''\n    + '<!DOCTYPE html>'\n    + '<html><head><meta charset=\"UTF-8\"></head>'\n    + '<body style=\"margin:0;padding:0;background:#f4f4f7;font-family:Arial,Helvetica,sans-serif;\">'\n    + '  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f4f7;padding:32px 0;\">'\n    + '    <tr><td align=\"center\">'\n    + '      <table width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:8px;overflow:hidden;\">'\n    + '        <tr><td style=\"background:#4F46E5;padding:24px;text-align:center;\">'\n    + '          <h1 style=\"color:#ffffff;margin:0;font-size:22px;\">Order Confirmed</h1>'\n    + '        </td></tr>'\n    + '        <tr><td style=\"padding:32px 24px;color:#222;\">'\n    + '          <p style=\"font-size:16px;margin:0 0 16px;\">Hi ' + recipientName + ',</p>'\n    + '          <p style=\"font-size:14px;line-height:1.6;color:#444;\">'\n    + '            Thanks for your purchase! We have received your order and it is now being processed.'\n    + '          </p>'\n    + '          <table width=\"100%\" cellpadding=\"8\" cellspacing=\"0\" style=\"background:#f9f9fb;border-radius:6px;margin:20px 0;font-size:14px;\">'\n    + '            <tr><td style=\"color:#666;\">Order ID</td><td style=\"text-align:right;font-weight:600;\">#' + orderId + '</td></tr>'\n    + '            <tr><td style=\"color:#666;\">Product</td><td style=\"text-align:right;font-weight:600;\">' + productName + '</td></tr>'\n    + '            <tr><td style=\"color:#666;\">Total</td><td style=\"text-align:right;font-weight:600;\">$' + orderTotal + '</td></tr>'\n    + '          </table>'\n    + '          <p style=\"font-size:14px;line-height:1.6;color:#444;\">We will send you another email when your order ships.</p>'\n    + '          <p style=\"margin-top:32px;font-size:14px;\">Cheers,<br/>' + senderName + '</p>'\n    + '        </td></tr>'\n    + '        <tr><td style=\"background:#f9f9fb;padding:16px;text-align:center;color:#999;font-size:12px;\">'\n    + '          This email was sent automatically by our system.'\n    + '        </td></tr>'\n    + '      </table>'\n    + '    </td></tr>'\n    + '  </table>'\n    + '</body></html>';\n\n  // ---- Manual UTF-8 -> bytes ----\n  function utf8Bytes(str) {\n    var bytes = [];\n    for (var i = 0; i < str.length; i++) {\n      var c = str.charCodeAt(i);\n      if (c < 0x80) {\n        bytes.push(c);\n      } else if (c < 0x800) {\n        bytes.push(0xc0 | (c >> 6), 0x80 | (c & 0x3f));\n      } else if (c < 0xd800 || c >= 0xe000) {\n        bytes.push(0xe0 | (c >> 12), 0x80 | ((c >> 6) & 0x3f), 0x80 | (c & 0x3f));\n      } else {\n        i++;\n        var cp = 0x10000 + (((c & 0x3ff) << 10) | (str.charCodeAt(i) & 0x3ff));\n        bytes.push(\n          0xf0 | (cp >> 18),\n          0x80 | ((cp >> 12) & 0x3f),\n          0x80 | ((cp >> 6) & 0x3f),\n          0x80 | (cp & 0x3f)\n        );\n      }\n    }\n    return bytes;\n  }\n\n  // ---- Manual base64 ----\n  function base64Encode(bytes) {\n    var chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n    var out = \"\";\n    var i = 0;\n    while (i < bytes.length) {\n      var b1 = bytes[i++];\n      var b2 = i < bytes.length ? bytes[i++] : -1;\n      var b3 = i < bytes.length ? bytes[i++] : -1;\n      out += chars.charAt(b1 >> 2);\n      out += chars.charAt(((b1 & 3) << 4) | ((b2 < 0 ? 0 : b2) >> 4));\n      out += b2 < 0 ? \"=\" : chars.charAt(((b2 & 15) << 2) | ((b3 < 0 ? 0 : b3) >> 6));\n      out += b3 < 0 ? \"=\" : chars.charAt(b3 & 63);\n    }\n    return out;\n  }\n\n  function b64(str)    { return base64Encode(utf8Bytes(str)); }\n  function b64url(str) { return b64(str).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, ''); }\n\n  var encodedSubject = '=?UTF-8?B?' + b64(subject) + '?=';\n  var encodedBody    = b64(htmlBody);\n\n  var mime = [\n    'From: ' + senderName + ' <' + senderEmail + '>',\n    'To: ' + recipientEmail,\n    'Subject: ' + encodedSubject,\n    'MIME-Version: 1.0',\n    'Content-Type: text/html; charset=UTF-8',\n    'Content-Transfer-Encoding: base64',\n    '',\n    encodedBody\n  ].join('\\r\\n');\n\n  var raw = b64url(mime);\n\n  return { raw: raw };\n}\n\nbuildGmailPayload();",
