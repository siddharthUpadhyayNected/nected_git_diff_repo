  "description": "",
  "query": "select customer_name, customer_id as customerNumber, category_name as productLine, name as productName, sum(customer_score) as customerScore,\nMIN(price) as price, \nMIN ((tmp.quantity_order)*100/(tmp.quantity_in_stock+tmp.quantity_order)) as inventory_booked_perc, \nsum(tmp.total_order) as order_volume, \nsum(tmp.quantity_order) as order_count from \n(SELECT o.id, c.name as customer_name,\no.created_at, o.customer_id, c.customer_score,\nod.product_id, od.quantity_order, od.price_each, c.credit_limit, pl.category_name, \np.name, p.quantity_in_stock, p.price, (od.quantity_order*od.price_each) as total_order\nFROM ecomm.orders o\nJOIN ecomm.order_details od ON o.id = od.order_id\nJOIN ecomm.products p ON od.product_id = p.id\nJOIN ecomm.customers c ON o.customer_id = c.id\nJOIN ecomm.product_lines pl ON p.category_id = pl.id) tmp\ngroup by productName, productLine, customerNumber, customer_name;",
