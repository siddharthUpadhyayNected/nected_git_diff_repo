  "query": "SELECT \r\n  e.\"empID\",\r\n  e.\"empName\",\r\n  e.\"team\",\r\n  e.\"approvalLimit\",\r\n  e.\"managerID\",\r\n  COUNT(i.\"accountApproverId\") AS \"allocations\"\r\nFROM \r\n  \"employee\" e\r\nLEFT JOIN \r\n  \"invoice\" i \r\n  ON i.\"accountApproverId\" = e.\"empID\"\r\nGROUP BY \r\n  e.\"empID\", \r\n  e.\"empName\", \r\n  e.\"team\", \r\n  e.\"approvalLimit\", \r\n  e.\"managerID\"\r\nORDER BY \r\n  \"allocations\" ASC;",
