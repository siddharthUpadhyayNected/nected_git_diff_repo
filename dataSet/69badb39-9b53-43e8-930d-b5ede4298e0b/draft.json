  "query": "SELECT \r\n  e.\"empID\",\r\n  e.\"empName\",\r\n  e.\"team\",\r\n  e.\"approvalLimit\",\r\n  e.\"managerID\",\r\n  e.\"level\",\r\n  COUNT(c.\"approverId\") AS \"allocations\"\r\nFROM \r\n  \"employee\" e\r\nLEFT JOIN \r\n  \"case\" c\r\n  ON c.\"approverId\" = e.\"empID\"\r\nGROUP BY \r\n  e.\"empID\", \r\n  e.\"empName\", \r\n  e.\"team\", \r\n  e.\"approvalLimit\", \r\n  e.\"managerID\",\r\n  e.\"level\"\r\nORDER BY \r\n  \"allocations\", e.\"level\" ASC;",
