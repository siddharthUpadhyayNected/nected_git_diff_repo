  "firstCustomInput": "expiryDate",
  "firstRuleChain": "",
  "ruleSetPolicy": "",
  "description": "Subscription-based businesses need to notify customers before their subscription expires to encourage timely renewal. This rule ensures that customers receive multiple reminders at different intervals before the subscription end date.\n\n30 Days Before Expiry: Send the first reminder via email.\n15 Days Before Expiry: Send a follow-up reminder via SMS & email.\n7 Days Before Expiry: Mark as \"Urgent\" and send an SMS, email, and push notification.\nOn Expiry Date: Send a final notification and suspend service if not renewed.",
  "policy": "order",
